<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <ImageView
        android:id="@+id/monImage"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:contentDescription="Image du drone"
        android:src="@drawable/drone"
        android:scaleType="fitCenter"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/textView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:textSize="16sp"
        android:gravity="center"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/btnPermissionsBT"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Permissions BT"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnActiverBT"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Activer BT"
            android:enabled="false"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnRechercher"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Rechercher des appareils"
            android:enabled="false"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnEffacerListe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Effacer la liste"
            android:layout_marginBottom="8dp"/>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Appareils trouvés :"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <ListView
        android:id="@+id/listView1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="100dp"
        android:divider="@android:color/darker_gray"
        android:dividerHeight="1dp"/>

</LinearLayout>