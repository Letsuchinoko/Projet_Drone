<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#DCD8A2"
    android:padding="16dp">

    <TextView
        android:id="@+id/soundLevelTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Niveau sonore\n\nEn attente de données..."
        android:textSize="18sp"
        android:gravity="center"
        android:textAlignment="center"
        android:background="#FF9800"
        android:textColor="#FFFFFF"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/soundLevelProgressBar"
        />

    <ProgressBar
        android:id="@+id/soundLevelProgressBar"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:max="120"
        android:progress="0"
        android:progressTint="@android:color/holo_orange_dark"
        app:layout_constraintTop_toBottomOf="@id/soundLevelTextView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginTop="16dp"/>

</androidx.constraintlayout.widget.ConstraintLayout> 